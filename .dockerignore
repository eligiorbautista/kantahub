# dependencies (reinstalled inside the image)
node_modules

# build output (built inside the image)
.next/
out/
build/

# version control
.git
.gitignore

# env files and secrets (never enter the build context)
.env
.env.*
!.env.example
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript build artifacts
*.tsbuildinfo

# local content libraries (mounted volumes at runtime — never baked in)
songs/
sound/
media/

# tests and fixtures (not needed to build or run)
tests/
vitest.config.ts
coverage/

# documentation and AI tooling artifacts (never ship in images)
docs/
README.md
.superpowers/
.opencode/
.claude/
.cursor/
.codex/
.aider*
Dockerfile
docker-compose.yml

# misc
.DS_Store
