# Kantahub environment configuration.
#
# Copy this file to `.env` (git-ignored) and edit as needed; docker-compose.yml
# reads it automatically. No secrets live here — Kantahub has no accounts and
# runs open on your LAN.

# ---------------------------------------------------------------------------
# PUBLIC_URL (optional)
# ---------------------------------------------------------------------------
# The absolute URL the TV page and phone remote should advertise, for example
# http://192.168.1.50:3005 . Leave it empty to use the address the browser
# actually reached the server on (correct behind Docker), falling back to the
# first non-loopback IPv4 address.
#
# Set it when auto-detection picks the wrong interface (VPN, Docker bridge,
# Wi-Fi + Ethernet, ...).
#
# In docker-compose.yml this is wired as: PUBLIC_URL=${PUBLIC_URL:-}
PUBLIC_URL=

# ---------------------------------------------------------------------------
# KANTAHUB_PORT (optional, default 3005)
# ---------------------------------------------------------------------------
# The host port Kantahub is published on. The container listens on the same
# value, so the phone-remote QR advertises the correct URL.
# KANTAHUB_PORT=3005

# ---------------------------------------------------------------------------
# KANTAHUB_TLS_HOST (optional, default 192.168.1.2)
# ---------------------------------------------------------------------------
# Only used by the optional HTTPS front door (`kantahub-https`, port 3443).
# Set it to the address clients use to reach this machine; it is signed into the
# self-signed certificate and used for QR codes on that origin.
# KANTAHUB_TLS_HOST=192.168.1.2

# ---------------------------------------------------------------------------
# Content directories (advanced; defaults shown)
# ---------------------------------------------------------------------------
# docker-compose.yml mounts host folders onto these image paths, so you only
# need to override them if you run the image with a different layout.
#
#   SONGS_DIR  ${SONGS_DIR:-/songs}   # your .mid / .kar library (bind mount)
#   SOUND_DIR  ${SOUND_DIR:-/sound}   # your SoundFont, e.g. GeneralUser-GS.sf2
#   MEDIA_DIR  ${MEDIA_DIR:-/media}   # optional background images/videos
#   MUSIC_DIR  ${MUSIC_DIR:-/music}   # optional idle music + score cheer
#   INDEX_DIR  ${INDEX_DIR:-/index}   # persisted index and rendered audio
#   PORT       ${PORT:-3000}          # HTTP port inside the container

# Uncomment a line only if you deviate from the defaults above.
# SONGS_DIR=/songs
# SOUND_DIR=/sound
# MEDIA_DIR=/media
# MUSIC_DIR=/music
# INDEX_DIR=/index
# PORT=3005
