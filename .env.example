# Kantahub environment configuration.
#
# Copy this file to `.env` (git-ignored) and edit as needed; docker-compose.yml
# reads it automatically. No secrets live here — Kantahub has no accounts and
# runs open on your LAN.

# ---------------------------------------------------------------------------
# PUBLIC_URL (optional)
# ---------------------------------------------------------------------------
# The absolute URL the TV page and phone remote should advertise on your LAN,
# for example http://192.168.1.50:3000 . Leave it empty to auto-detect the
# first non-loopback IPv4 address. Set it when auto-detection picks the wrong
# network interface (VPN, Docker bridge, Wi-Fi + Ethernet, ...).
#
# In docker-compose.yml this is wired as: PUBLIC_URL=${PUBLIC_URL:-}
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Content and cache directories (advanced; defaults shown)
# ---------------------------------------------------------------------------
# docker-compose.yml mounts host folders onto these image paths, so you only
# need to override them if you run the image with a different layout.
# Each is read through ${VAR:-default} by the app:
#
#   SONGS_DIR  ${SONGS_DIR:-/songs}   # your .mid / .kar library (bind mount)
#   SOUND_DIR  ${SOUND_DIR:-/sound}   # your SoundFont, e.g. GeneralUser-GS.sf2
#   MEDIA_DIR  ${MEDIA_DIR:-/media}   # optional background images/videos
#   INDEX_DIR  ${INDEX_DIR:-/index}   # persisted library index (named volume)
#   PORT       ${PORT:-3000}          # HTTP port inside the container

# ---------------------------------------------------------------------------
# KANTAHUB_PORT (optional)
# ---------------------------------------------------------------------------
# The host port Kantahub is published on. Defaults to 3005 because port 3000 was
# already in use on this host. The container's PORT is set to the same value so
# the phone-remote QR advertises the correct URL.
# KANTAHUB_PORT=3005

# Uncomment a line only if you deviate from the defaults above.
# SONGS_DIR=/songs
# SOUND_DIR=/sound
# MEDIA_DIR=/media
# INDEX_DIR=/index
# PORT=3000
